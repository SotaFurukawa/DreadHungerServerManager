<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!-- EC2 上で Windows サービスとして動く常駐サービス。Windows にログインしなくても、
       EC2 の起動時に Dread Hunger サーバーを起動し、GUI・Discord Bot からの要求を処理する。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>DreadHungerServerManager.Host</AssemblyName>
    <RootNamespace>DreadHungerServerManager.Host</RootNamespace>
    <ApplicationIcon>..\DreadHungerServerManager.App\Assets\AppIcon.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DreadHungerServerManager.Aws\DreadHungerServerManager.Aws.csproj" />
    <ProjectReference Include="..\DreadHungerServerManager.Core\DreadHungerServerManager.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
  </ItemGroup>

</Project>
