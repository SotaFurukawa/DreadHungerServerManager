<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DreadHungerServerManager.App.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <ScrollViewer>
        <StackPanel
            MaxWidth="880"
            Padding="24,16,24,32"
            HorizontalAlignment="Left"
            Spacing="16">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="アプリ情報" />

            <Border Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Width="64"
                        Height="64"
                        VerticalAlignment="Top"
                        Source="ms-appx:///Assets/AppIcon.ico" />
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="{x:Bind Title}" />
                        <TextBlock Text="{x:Bind VersionText}" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Dread Hunger Dedicated Server（DreadHungerServer.exe）を、batファイルやPowerShellを使わずに起動・停止・監視するためのアプリです。" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="動作環境" />
                    <TextBlock Text="Windows 10（1809以降）/ Windows 11 / Windows Server 2019以降（デスクトップエクスペリエンス）" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind EnvironmentText}" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text=".NET と Windows App SDK はアプリに同梱しているため、別途インストールする必要はありません。" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
