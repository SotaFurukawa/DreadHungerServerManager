<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DreadHungerServerManager.App.Views.CloudPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DreadHungerServerManager.App.Views"
    NavigationCacheMode="Required">

    <ScrollViewer>
        <StackPanel
            MaxWidth="1200"
            Padding="24,16,24,32"
            HorizontalAlignment="Left"
            Spacing="16">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="AWS / Cloud" />

            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind Cloud.IsSimulated}"
                Message="--fake-cloud で起動しているため、実際の AWS ではなく疑似 EC2 を操作しています（動作確認用）。"
                Severity="Warning"
                Title="疑似 EC2" />

            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind Cloud.HasError, Mode=OneWay}"
                Message="{x:Bind Cloud.ErrorMessage, Mode=OneWay}"
                Severity="Error"
                Title="AWS の操作に失敗しました" />

            <!-- EC2 インスタンス -->
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="20" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <Grid Width="40" Height="40" VerticalAlignment="Center">
                            <ProgressRing Width="40" Height="40" IsActive="{x:Bind Cloud.IsBusy, Mode=OneWay}" />
                            <Ellipse
                                Width="16"
                                Height="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Fill="{x:Bind local:ViewHelpers.CloudStateBrush(Cloud.State), Mode=OneWay}" />
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource FactCaptionTextStyle}" Text="EC2" />
                            <TextBlock
                                AutomationProperties.AutomationId="CloudStateTextBlock"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Text="{x:Bind Cloud.StateText, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Column="1" VerticalAlignment="Center" ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FactCaptionTextStyle}" Text="インスタンス" />
                            <TextBlock Style="{StaticResource FactValueTextStyle}" Text="{x:Bind Cloud.InstanceText, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource FactCaptionTextStyle}" Text="パブリック IP" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="PublicIpTextBlock"
                                    IsTextSelectionEnabled="True"
                                    Style="{StaticResource FactValueTextStyle}"
                                    Text="{x:Bind Cloud.PublicIpText, Mode=OneWay}" />
                                <Button
                                    Padding="6,2"
                                    AutomationProperties.Name="IP アドレスをコピー"
                                    Command="{x:Bind Cloud.CopyIpCommand}"
                                    ToolTipService.ToolTip="IP アドレスをコピー">
                                    <FontIcon FontSize="12" Glyph="&#xE8C8;" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FactCaptionTextStyle}" Text="起動時刻" />
                            <TextBlock Style="{StaticResource FactValueTextStyle}" Text="{x:Bind Cloud.LaunchTimeText, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            AutomationProperties.AutomationId="CloudStartButton"
                            Command="{x:Bind Cloud.StartCommand}"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE768;" />
                                <TextBlock Text="EC2 起動" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.AutomationId="CloudStopButton" Command="{x:Bind Cloud.StopCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE71A;" />
                                <TextBlock Text="EC2 停止" />
                            </StackPanel>
                        </Button>
                        <Button
                            AutomationProperties.AutomationId="CloudRefreshButton"
                            AutomationProperties.Name="更新"
                            Command="{x:Bind Cloud.RefreshCommand}"
                            ToolTipService.ToolTip="更新">
                            <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        </Button>
                    </StackPanel>

                    <TextBlock
                        Grid.Row="1"
                        Grid.ColumnSpan="3"
                        AutomationProperties.AutomationId="CloudDetailTextBlock"
                        Style="{StaticResource SecondaryTextStyle}"
                        Text="{x:Bind Cloud.StateDetailText, Mode=OneWay}" />
                </Grid>
            </Border>

            <!-- 起動に使うゲーム設定（「サーバー」ページと共通の設定欄） -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="460" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <local:GameSettingsPanel />
                <Border
                    Grid.Column="1"
                    VerticalAlignment="Top"
                    Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="起動に使うゲーム設定" />
                        <TextBlock
                            AutomationProperties.AutomationId="LaunchSettingsSummaryTextBlock"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="{x:Bind Cloud.LaunchSettingsSummary, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Style="{StaticResource SecondaryTextStyle}"
                            Text="「EC2 起動」を押すと、左の設定を EC2 上の常駐サービスに渡してから EC2 を起動します。Windows が起動すると、常駐サービスがこの設定でゲームサーバーを立ち上げます。起動が終わるまで、この画面で待って結果を表示します。"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Style="{StaticResource SecondaryTextStyle}"
                            Text="設定は「サーバー」ページと共通です。最後に起動した設定は EC2 側にも保存されるため、AWS コンソールなどから EC2 を起動した場合も、その設定で起動します。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 接続先 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="接続先" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="ConnectAddressTextBlock"
                            FontFamily="Consolas"
                            FontSize="22"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind Cloud.ConnectAddressText, Mode=OneWay}" />
                        <Button AutomationProperties.AutomationId="CopyAddressButton" Command="{x:Bind Cloud.CopyAddressCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                                <TextBlock Text="コピー" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="EC2 は停止・起動のたびにパブリック IP が変わります（Elastic IP を割り当てた場合を除く）。遊ぶ前にここで最新の接続先を確認してください。" />
                </StackPanel>
            </Border>

            <!-- EC2 上のゲームサーバー（EC2 の状態とは別） -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="EC2 上のゲームサーバー" />
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Ellipse
                                Width="14"
                                Height="14"
                                VerticalAlignment="Center"
                                Fill="{x:Bind local:ViewHelpers.StateBrush(Cloud.RemoteState), Mode=OneWay}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="RemoteStateTextBlock"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Text="{x:Bind Cloud.RemoteStateText, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button AutomationProperties.AutomationId="RemoteStartButton" Command="{x:Bind Cloud.RemoteStartCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE768;" />
                                    <TextBlock Text="ゲームサーバー起動" />
                                </StackPanel>
                            </Button>
                            <Button AutomationProperties.AutomationId="RemoteRestartButton" Command="{x:Bind Cloud.RemoteRestartCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                                    <TextBlock Text="再起動" />
                                </StackPanel>
                            </Button>
                            <Button AutomationProperties.AutomationId="RemoteStopButton" Command="{x:Bind Cloud.RemoteStopCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE71A;" />
                                    <TextBlock Text="停止" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <TextBlock
                        AutomationProperties.AutomationId="RemoteDetailTextBlock"
                        Text="{x:Bind Cloud.RemoteDetailText, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Style="{StaticResource SecondaryTextStyle}"
                        Text="{x:Bind Cloud.RemoteLastResultText, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Text="{x:Bind Cloud.RemoteError, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind Cloud.HasRemoteError, Mode=OneWay}" />
                    <TextBlock
                        Style="{StaticResource SecondaryTextStyle}"
                        Text="{x:Bind Cloud.RemoteLaunchSettingsText, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap">
                        <Run Text="EC2 の状態とゲームサーバーの状態は別です。EC2 が稼働中でも、ゲームサーバーが起動していなければ接続できません。操作は EC2 上の常駐サービスが数秒ごとに受け取って実行します（README の「EC2 の常駐サービス」）。" /><LineBreak /><Run Text="このアプリで管理しているサーバー: " /><Run FontWeight="SemiBold" Text="{x:Bind Server.StateText, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 自動停止 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="自動停止（料金の節約）" />
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <CheckBox
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="IdleShutdownCheckBox"
                            Content="誰も遊んでいない状態が続いたら停止"
                            IsChecked="{x:Bind Cloud.IdleShutdownEnabled, Mode=TwoWay}" />
                        <NumberBox
                            Grid.Column="1"
                            Width="140"
                            AutomationProperties.Name="停止までの時間（分）"
                            Maximum="240"
                            Minimum="5"
                            SpinButtonPlacementMode="Inline"
                            Value="{x:Bind Cloud.IdleTimeoutMinutes, Mode=TwoWay}" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Text="分" />
                        <CheckBox
                            Grid.Row="1"
                            VerticalAlignment="Center"
                            Content="起動から一定時間で停止（最大稼働時間）"
                            IsChecked="{x:Bind Cloud.MaxRuntimeEnabled, Mode=TwoWay}" />
                        <NumberBox
                            Grid.Row="1"
                            Grid.Column="1"
                            Width="140"
                            AutomationProperties.Name="最大稼働時間（時間）"
                            Maximum="24"
                            Minimum="1"
                            SpinButtonPlacementMode="Inline"
                            Value="{x:Bind Cloud.MaxRuntimeHours, Mode=TwoWay}" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Text="時間" />
                    </Grid>
                    <TextBlock
                        Style="{StaticResource SecondaryTextStyle}"
                        Text="「誰も遊んでいない」は、ゲームサーバーが止まったまま（起動していない・試合が終わって終了した）か、参加者が0人の状態です。ゲームサーバーの起動・操作・参加があると数え直します。最大稼働時間は試合中でも停止します（30分前・10分前・5分前に警告）。どちらも、ゲームサーバーを安全に止めてから EC2 を停止します。"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button
                            AutomationProperties.AutomationId="ApplyAutoStopButton"
                            Command="{x:Bind Cloud.ApplyAutoStopCommand}"
                            Content="EC2 に反映" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryTextStyle}"
                            Text="{x:Bind Cloud.AppliedAutoStopText, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 接続設定 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="接続設定" />
                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox
                            AutomationProperties.AutomationId="RegionTextBox"
                            Header="リージョン"
                            PlaceholderText="例: ap-northeast-3（大阪）"
                            Text="{x:Bind Cloud.Region, Mode=TwoWay}" />
                        <TextBox
                            Grid.Column="1"
                            AutomationProperties.AutomationId="InstanceIdTextBox"
                            Header="インスタンスID"
                            PlaceholderText="例: i-0123456789abcdef0"
                            Text="{x:Bind Cloud.InstanceId, Mode=TwoWay}" />
                        <ComboBox
                            Grid.Row="1"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="ProfileComboBox"
                            Header="AWS プロファイル（空欄なら既定の認証）"
                            IsEditable="True"
                            ItemsSource="{x:Bind Cloud.AvailableProfiles, Mode=OneWay}"
                            PlaceholderText="既定（環境変数・default プロファイル・EC2 の IAM ロール）"
                            Text="{x:Bind Cloud.ProfileName, Mode=TwoWay}" />
                        <NumberBox
                            Grid.Row="1"
                            Grid.Column="1"
                            Header="ゲームのポート（UDP）"
                            Maximum="65535"
                            Minimum="1"
                            SpinButtonPlacementMode="Inline"
                            Value="{x:Bind Cloud.GamePort, Mode=TwoWay}" />
                    </Grid>
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Text="{x:Bind Cloud.SettingsErrorText, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind Cloud.HasSettingsError, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryTextStyle}"
                            Text="{x:Bind Cloud.ProfilesText, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <HyperlinkButton Command="{x:Bind Cloud.ReloadProfilesCommand}" Content="再読み込み" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap">
                        <Run Text="アクセスキーはこのアプリに入力・保存しません。AWS の認証情報は、共有認証情報ファイル（%USERPROFILE%\.aws\credentials）のプロファイル、環境変数、または EC2 の IAM ロールから読み込みます。" /><LineBreak /><Run Text="ルートユーザーではなく、このインスタンスの起動・停止だけを許可した IAM ユーザーを使ってください（手順は README の「AWS の設定」）。" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
