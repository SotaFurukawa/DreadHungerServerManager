<?xml version="1.0" encoding="utf-8" ?>
<!-- プリセットとマップ・ゲーム設定の欄。「サーバー」ページと「AWS / Cloud」ページで共通に使い、内容（ServerViewModel.Game）も共有する。 -->
<UserControl
    x:Class="DreadHungerServerManager.App.Views.GameSettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DreadHungerServerManager.App.Views"
    xmlns:models="using:DreadHungerServerManager.Core.Models"
    xmlns:vm="using:DreadHungerServerManager.App.ViewModels">

    <UserControl.Resources>
        <!-- 整数の設定（直接入力＋上下ボタン）。範囲外も入力でき、その場合は下にエラーを出す。 -->
        <DataTemplate x:Key="IntegerSettingTemplate" x:DataType="vm:NumericSettingViewModel">
            <Grid Margin="0,4" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Label}" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Caption}" />
                </StackPanel>
                <NumberBox
                    Grid.Column="1"
                    Width="150"
                    AutomationProperties.Name="{x:Bind Label}"
                    LargeChange="{x:Bind LargeChange}"
                    SmallChange="{x:Bind SmallChange}"
                    SpinButtonPlacementMode="Inline"
                    Value="{x:Bind Value, Mode=TwoWay}" />
                <TextBlock
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Margin="0,4,0,0"
                    FontSize="12"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Text="{x:Bind Error, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind HasError, Mode=OneWay}" />
            </Grid>
        </DataTemplate>

        <!-- 倍率（小数2桁表示＋よく使う値のドロップダウン）。 -->
        <DataTemplate x:Key="MultiplierSettingTemplate" x:DataType="vm:NumericSettingViewModel">
            <Grid Margin="0,4" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Label}" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Caption}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <NumberBox
                        Width="150"
                        AutomationProperties.Name="{x:Bind Label}"
                        LargeChange="{x:Bind LargeChange}"
                        Loaded="MultiplierNumberBox_Loaded"
                        SmallChange="{x:Bind SmallChange}"
                        SpinButtonPlacementMode="Inline"
                        Value="{x:Bind Value, Mode=TwoWay}" />
                    <DropDownButton
                        Padding="8,6"
                        AutomationProperties.Name="よく使う倍率"
                        Loaded="QuickValueButton_Loaded"
                        ToolTipService.ToolTip="よく使う倍率から選ぶ">
                        <FontIcon FontSize="14" Glyph="&#xE8FD;" />
                    </DropDownButton>
                </StackPanel>
                <TextBlock
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Margin="0,4,0,0"
                    FontSize="12"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Text="{x:Bind Error, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind HasError, Mode=OneWay}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel Spacing="16">
        <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel Spacing="10">
                <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="プリセット" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="プリセット"
                        ItemsSource="{x:Bind ViewModel.Presets.Items}"
                        PlaceholderText="プリセットを選択"
                        SelectedItem="{x:Bind ViewModel.Presets.SelectedItem, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:PresetItemViewModel">
                                <StackPanel>
                                    <TextBlock Text="{x:Bind DisplayName}" />
                                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Description}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Stretch"
                        Command="{x:Bind ViewModel.Presets.LoadCommand}"
                        Content="読み込み" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.Presets.SaveAsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE74E;" />
                            <TextBlock Text="名前を付けて保存…" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.Presets.DeleteCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE74D;" />
                            <TextBlock Text="削除" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="標準プリセット（Standard / Short Game / Long Game）はマップを変えずに読み込みます。標準プリセットは削除できません。" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel Spacing="6">
                <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="マップ・ゲーム設定" />
                <ComboBox
                    Margin="0,6,0,0"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="MapComboBox"
                    Header="マップ"
                    ItemsSource="{x:Bind ViewModel.Game.Maps}"
                    SelectedItem="{x:Bind ViewModel.Game.SelectedMapItem, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:GameMapInfo">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{x:Bind DisplayName}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="{x:Bind MapName}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="プレイヤー" />
                <ItemsControl ItemTemplate="{StaticResource IntegerSettingTemplate}" ItemsSource="{x:Bind ViewModel.Game.PlayerSettings}" />

                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="時間" />
                <ItemsControl ItemTemplate="{StaticResource IntegerSettingTemplate}" ItemsSource="{x:Bind ViewModel.Game.TimeSettings}" />

                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="倍率" />
                <ItemsControl ItemTemplate="{StaticResource MultiplierSettingTemplate}" ItemsSource="{x:Bind ViewModel.Game.MultiplierSettings}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
